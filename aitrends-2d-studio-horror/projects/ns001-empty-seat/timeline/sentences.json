[
 {
  "i": 0,
  "start": 0.08,
  "end": 4.6,
  "text": "If your car ever beeps for the empty passenger seat, do not look at the seat."
 },
 {
  "i": 1,
  "start": 4.88,
  "end": 6.24,
  "text": "Do not reach across."
 },
 {
  "i": 2,
  "start": 6.48,
  "end": 9.68,
  "text": "And do not, under any circumstances, buckle it in."
 },
 {
  "i": 3,
  "start": 10.08,
  "end": 11.52,
  "text": "You have heard this before."
 },
 {
  "i": 4,
  "start": 11.84,
  "end": 13.36,
  "text": "You put your bag on the seat."
 },
 {
  "i": 5,
  "start": 13.68,
  "end": 14.6,
  "text": "Your groceries."
 },
 {
  "i": 6,
  "start": 14.72,
  "end": 15.72,
  "text": "A pizza."
 },
 {
  "i": 7,
  "start": 16.08,
  "end": 21.56,
  "text": "The little seatbelt light came on and the car started beeping, like your pizza had a death wish."
 },
 {
  "i": 8,
  "start": 21.92,
  "end": 24.36,
  "text": "You moved it, and the beeping stopped."
 },
 {
  "i": 9,
  "start": 24.72,
  "end": 27.08,
  "text": "Tonight, there is nothing on the seat."
 },
 {
  "i": 10,
  "start": 27.44,
  "end": 28.76,
  "text": "It is still beeping."
 },
 {
  "i": 11,
  "start": 29.12,
  "end": 30.6,
  "text": "There are seven rules."
 },
 {
  "i": 12,
  "start": 30.96,
  "end": 32.16,
  "text": "Six get you home."
 },
 {
  "i": 13,
  "start": 32.48,
  "end": 34.92,
  "text": "The seventh is about who drove."
 },
 {
  "i": 14,
  "start": 35.36,
  "end": 37.56,
  "text": "Under the passenger seat is a sensor."
 },
 {
  "i": 15,
  "start": 37.84,
  "end": 39.12,
  "text": "It measures weight."
 },
 {
  "i": 16,
  "start": 39.52,
  "end": 44.36,
  "text": "If something on that seat weighs as much as a person, the car asks it to buckle up."
 },
 {
  "i": 17,
  "start": 44.72,
  "end": 46.84,
  "text": "The car does not know what a person is."
 },
 {
  "i": 18,
  "start": 47.04,
  "end": 49.44,
  "text": "It only knows what one weighs."
 },
 {
  "i": 19,
  "start": 49.68,
  "end": 52.88,
  "text": "Tonight, something weighs exactly that much."
 },
 {
  "i": 20,
  "start": 53.36,
  "end": 54.2,
  "text": "Rule one."
 },
 {
  "i": 21,
  "start": 54.56,
  "end": 55.96,
  "text": "Do not look at the seat."
 },
 {
  "i": 22,
  "start": 56.32,
  "end": 57.36,
  "text": "Eyes on the road."
 },
 {
  "i": 23,
  "start": 57.6,
  "end": 58.76,
  "text": "Hands on the wheel."
 },
 {
  "i": 24,
  "start": 59.12,
  "end": 61.32,
  "text": "You will feel the urge to glance over."
 },
 {
  "i": 25,
  "start": 61.52,
  "end": 62.72,
  "text": "Everybody does."
 },
 {
  "i": 26,
  "start": 63.04,
  "end": 64.88,
  "text": "Do not tilt the mirror either."
 },
 {
  "i": 27,
  "start": 65.2,
  "end": 66.92,
  "text": "The mirror was set for the road."
 },
 {
  "i": 28,
  "start": 67.12,
  "end": 68.32,
  "text": "Keep it that way."
 },
 {
  "i": 29,
  "start": 68.8,
  "end": 69.56,
  "text": "Rule two."
 },
 {
  "i": 30,
  "start": 69.92,
  "end": 71.88,
  "text": "Do not put anything on the seat."
 },
 {
  "i": 31,
  "start": 72.24,
  "end": 76.24,
  "text": "You will want to toss your bag over, so the beeping has a reason."
 },
 {
  "i": 32,
  "start": 76.56,
  "end": 78.0,
  "text": "Do not give it a reason."
 },
 {
  "i": 33,
  "start": 78.24,
  "end": 79.8,
  "text": "Do not give it anything."
 },
 {
  "i": 34,
  "start": 80.16,
  "end": 83.12,
  "text": "Things put on that seat tonight do not come back."
 },
 {
  "i": 35,
  "start": 83.6,
  "end": 84.44,
  "text": "Rule three."
 },
 {
  "i": 36,
  "start": 84.8,
  "end": 86.24,
  "text": "Take the lit roads."
 },
 {
  "i": 37,
  "start": 86.56,
  "end": 88.24,
  "text": "Stay under the streetlights."
 },
 {
  "i": 38,
  "start": 88.56,
  "end": 91.36,
  "text": "Every time you pass under one, the beeping will stop."
 },
 {
  "i": 39,
  "start": 91.68,
  "end": 92.92,
  "text": "Just for a second."
 },
 {
  "i": 40,
  "start": 93.28,
  "end": 95.16,
  "text": "Count the seconds between lights."
 },
 {
  "i": 41,
  "start": 95.44,
  "end": 97.68,
  "text": "If the beeping stops in the dark too..."
 },
 {
  "i": 42,
  "start": 98.0,
  "end": 99.56,
  "text": "it has gotten used to you."
 },
 {
  "i": 43,
  "start": 99.92,
  "end": 101.64,
  "text": "That is not good news."
 },
 {
  "i": 44,
  "start": 102.16,
  "end": 103.08,
  "text": "Rule four."
 },
 {
  "i": 45,
  "start": 103.44,
  "end": 104.96,
  "text": "Let it choose the music."
 },
 {
  "i": 46,
  "start": 105.28,
  "end": 108.64,
  "text": "If the radio changes station by itself, leave it."
 },
 {
  "i": 47,
  "start": 109.04,
  "end": 110.72,
  "text": "Passengers pick the music."
 },
 {
  "i": 48,
  "start": 110.96,
  "end": 112.28,
  "text": "Everybody knows that."
 },
 {
  "i": 49,
  "start": 112.56,
  "end": 114.16,
  "text": "It has terrible taste."
 },
 {
  "i": 50,
  "start": 114.48,
  "end": 115.6,
  "text": "Do not say so."
 },
 {
  "i": 51,
  "start": 115.84,
  "end": 117.44,
  "text": "And do not turn it down."
 },
 {
  "i": 52,
  "start": 117.76,
  "end": 119.52,
  "text": "It turned it up for a reason."
 },
 {
  "i": 53,
  "start": 119.84,
  "end": 122.36,
  "text": "There is something it does not want you to hear."
 },
 {
  "i": 54,
  "start": 122.88,
  "end": 123.88,
  "text": "Rule five."
 },
 {
  "i": 55,
  "start": 124.16,
  "end": 126.16,
  "text": "Do not stop until you are home."
 },
 {
  "i": 56,
  "start": 126.48,
  "end": 127.52,
  "text": "Not for gas."
 },
 {
  "i": 57,
  "start": 127.68,
  "end": 128.72,
  "text": "Not for food."
 },
 {
  "i": 58,
  "start": 128.96,
  "end": 130.48,
  "text": "Not to check the tires."
 },
 {
  "i": 59,
  "start": 130.8,
  "end": 135.48,
  "text": "If a red light makes you stop, keep both hands on the wheel and look straight ahead."
 },
 {
  "i": 60,
  "start": 135.84,
  "end": 137.6,
  "text": "Something will tap on the window."
 },
 {
  "i": 61,
  "start": 137.92,
  "end": 139.44,
  "text": "Not the passenger window."
 },
 {
  "i": 62,
  "start": 139.76,
  "end": 140.76,
  "text": "Yours."
 },
 {
  "i": 63,
  "start": 141.28,
  "end": 142.32,
  "text": "Rule six."
 },
 {
  "i": 64,
  "start": 142.64,
  "end": 145.4,
  "text": "When you park, do not look in the back seat."
 },
 {
  "i": 65,
  "start": 145.84,
  "end": 149.2,
  "text": "Some cars can now tell when something moves in the back seat."
 },
 {
  "i": 66,
  "start": 149.6,
  "end": 151.08,
  "text": "Hyundai offers one."
 },
 {
  "i": 67,
  "start": 151.44,
  "end": 155.04,
  "text": "After you park and lock, a sensor watches the rear seats."
 },
 {
  "i": 68,
  "start": 155.36,
  "end": 160.52,
  "text": "If something moves, the car honks the horn, flashes the lights, and texts your phone."
 },
 {
  "i": 69,
  "start": 160.88,
  "end": 164.76,
  "text": "It was built so nobody forgets a child or a dog in a hot car."
 },
 {
  "i": 70,
  "start": 165.12,
  "end": 166.8,
  "text": "It was not built for this."
 },
 {
  "i": 71,
  "start": 167.2,
  "end": 168.2,
  "text": "Lock the car."
 },
 {
  "i": 72,
  "start": 168.48,
  "end": 169.64,
  "text": "Walk inside."
 },
 {
  "i": 73,
  "start": 170.0,
  "end": 173.4,
  "text": "If your phone buzzes, movement detected in rear seat\"..."
 },
 {
  "i": 74,
  "start": 173.68,
  "end": 175.0,
  "text": "do not go back."
 },
 {
  "i": 75,
  "start": 175.36,
  "end": 176.96,
  "text": "You did not forget anything."
 },
 {
  "i": 76,
  "start": 177.28,
  "end": 178.84,
  "text": "It just has not gotten out yet."
 },
 {
  "i": 77,
  "start": 178.88,
  "end": 179.84,
  "text": "Rule seven."
 },
 {
  "i": 78,
  "start": 180.08,
  "end": 182.12,
  "text": "Do not try to remember the drive."
 },
 {
  "i": 79,
  "start": 182.4,
  "end": 183.64,
  "text": "Here is something true."
 },
 {
  "i": 80,
  "start": 183.92,
  "end": 186.96,
  "text": "You have driven home before and not remembered the drive."
 },
 {
  "i": 81,
  "start": 187.2,
  "end": 188.24,
  "text": "Not one turn."
 },
 {
  "i": 82,
  "start": 188.4,
  "end": 189.44,
  "text": "Not one light."
 },
 {
  "i": 83,
  "start": 189.68,
  "end": 190.8,
  "text": "You just arrived."
 },
 {
  "i": 84,
  "start": 191.04,
  "end": 192.32,
  "text": "Everybody has done it."
 },
 {
  "i": 85,
  "start": 192.56,
  "end": 194.44,
  "text": "It is called highway hypnosis."
 },
 {
  "i": 86,
  "start": 194.72,
  "end": 199.36,
  "text": "Experts say your brain drives on autopilot while your mind wanders."
 },
 {
  "i": 87,
  "start": 199.6,
  "end": 201.12,
  "text": "Your mind was not wandering."
 },
 {
  "i": 88,
  "start": 201.28,
  "end": 202.36,
  "text": "It was moved."
 },
 {
  "i": 89,
  "start": 202.64,
  "end": 203.92,
  "text": "One seat to the right."
 },
 {
  "i": 90,
  "start": 204.16,
  "end": 208.6,
  "text": "That is why the passenger seat weighed exactly as much as a person tonight."
 },
 {
  "i": 91,
  "start": 208.88,
  "end": 209.68,
  "text": "It was you."
 },
 {
  "i": 92,
  "start": 209.92,
  "end": 212.76,
  "text": "For the first time, you were awake for the ride."
 },
 {
  "i": 93,
  "start": 213.04,
  "end": 217.14,
  "text": "So if your car ever beeps for the empty passenger seat, don't look."
 },
 {
  "i": 94,
  "start": 217.76,
  "end": 219.92,
  "text": "You might see who has been driving."
 },
 {
  "i": 95,
  "start": 220.24,
  "end": 221.84,
  "text": "Thank you for calling Night Support."
 },
 {
  "i": 96,
  "start": 222.08,
  "end": 223.211,
  "text": "Please drive safely."
 },
 {
  "i": 97,
  "start": 223.76,
  "end": 224.72,
  "text": "Someone has to."
 }
]