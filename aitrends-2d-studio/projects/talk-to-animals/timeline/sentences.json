[
 {
  "i": 0,
  "start": 0.16,
  "end": 0.85,
  "text": "Bacon."
 },
 {
  "i": 1,
  "start": 1.23,
  "end": 1.94,
  "text": "Under the chair."
 },
 {
  "i": 2,
  "start": 2.37,
  "end": 3.19,
  "text": "Left side."
 },
 {
  "i": 3,
  "start": 3.83,
  "end": 4.46,
  "text": "You look."
 },
 {
  "i": 4,
  "start": 5.08,
  "end": 7.09,
  "text": "There's a piece of bacon under the chair."
 },
 {
  "i": 5,
  "start": 7.86,
  "end": 8.58,
  "text": "Left side."
 },
 {
  "i": 6,
  "start": 9.07,
  "end": 11.14,
  "text": "That's forty-one pieces this year."
 },
 {
  "i": 7,
  "start": 11.38,
  "end": 12.26,
  "text": "I've been counting."
 },
 {
  "i": 8,
  "start": 12.91,
  "end": 14.98,
  "text": "The cat walks across the breakfast table."
 },
 {
  "i": 9,
  "start": 14.98,
  "end": 15.04,
  "text": "Ugh."
 },
 {
  "i": 10,
  "start": 16.5,
  "end": 17.39,
  "text": "You're awake."
 },
 {
  "i": 11,
  "start": 18.17,
  "end": 22.7,
  "text": "And outside, every bird on the street is screaming the same thing."
 },
 {
  "i": 12,
  "start": 23.72,
  "end": 23.92,
  "text": "My tree!"
 },
 {
  "i": 13,
  "start": 24.06,
  "end": 24.25,
  "text": "My tree!"
 },
 {
  "i": 14,
  "start": 25.22,
  "end": 25.33,
  "text": "MY TREE!"
 },
 {
  "i": 15,
  "start": 27.12,
  "end": 27.85,
  "text": "So..."
 },
 {
  "i": 16,
  "start": 28.43,
  "end": 30.12,
  "text": "what if you could talk to animals?"
 },
 {
  "i": 17,
  "start": 31.12,
  "end": 32.15,
  "text": "Here's how it works."
 },
 {
  "i": 18,
  "start": 32.8,
  "end": 34.66,
  "text": "You understand every animal."
 },
 {
  "i": 19,
  "start": 35.24,
  "end": 37.33,
  "text": "And every animal understands you."
 },
 {
  "i": 20,
  "start": 38.06,
  "end": 39.16,
  "text": "There's no off switch."
 },
 {
  "i": 21,
  "start": 39.74,
  "end": 40.78,
  "text": "Not for a second."
 },
 {
  "i": 22,
  "start": 41.53,
  "end": 42.81,
  "text": "That part matters later."
 },
 {
  "i": 23,
  "start": 43.65,
  "end": 45.08,
  "text": "Biscuit is fourteen."
 },
 {
  "i": 24,
  "start": 45.73,
  "end": 46.88,
  "text": "He's a year older than you."
 },
 {
  "i": 25,
  "start": 47.7,
  "end": 51.64,
  "text": "Mom found him at a gas station in the rain, the winter before you were born."
 },
 {
  "i": 26,
  "start": 52.39,
  "end": 56.22,
  "text": "A wet, angry puppy who bit her sleeve and wouldn't let go."
 },
 {
  "i": 27,
  "start": 57.04,
  "end": 59.3,
  "text": "He's been there for every day of your life."
 },
 {
  "i": 28,
  "start": 59.99,
  "end": 61.28,
  "text": "Every scraped knee."
 },
 {
  "i": 29,
  "start": 61.86,
  "end": 63.16,
  "text": "Every bad dream."
 },
 {
  "i": 30,
  "start": 64.0,
  "end": 66.24,
  "text": "You've talked to him every single day."
 },
 {
  "i": 31,
  "start": 67.13,
  "end": 69.35,
  "text": "Today, for the first time,"
 },
 {
  "i": 32,
  "start": 70.17,
  "end": 71.08,
  "text": "he talks back."
 },
 {
  "i": 33,
  "start": 72.18,
  "end": 75.81,
  "text": "And at first, it's the best thing that has ever happened to you."
 },
 {
  "i": 34,
  "start": 76.63,
  "end": 78.83,
  "text": "You ask Biscuit what he wants for his birthday."
 },
 {
  "i": 35,
  "start": 79.34,
  "end": 80.13,
  "text": "The couch."
 },
 {
  "i": 36,
  "start": 80.35,
  "end": 80.99,
  "text": "All of it."
 },
 {
  "i": 37,
  "start": 81.14,
  "end": 82.02,
  "text": "Forever."
 },
 {
  "i": 38,
  "start": 82.65,
  "end": 85.68,
  "text": "You ask Pickles why she keeps pushing cups off the table."
 },
 {
  "i": 39,
  "start": 86.15,
  "end": 87.62,
  "text": "To check if they still fall."
 },
 {
  "i": 40,
  "start": 88.42,
  "end": 90.52,
  "text": "A pigeon gives you directions to school."
 },
 {
  "i": 41,
  "start": 90.99,
  "end": 92.01,
  "text": "Left at the bakery."
 },
 {
  "i": 42,
  "start": 92.42,
  "end": 94.12,
  "text": "Right at the man with the sandwich."
 },
 {
  "i": 43,
  "start": 94.51,
  "end": 96.68,
  "text": "Stay near the man with the sandwich."
 },
 {
  "i": 44,
  "start": 97.37,
  "end": 99.99,
  "text": "A squirrel finds the house key you lost in May."
 },
 {
  "i": 45,
  "start": 100.67,
  "end": 101.62,
  "text": "He wants a peanut."
 },
 {
  "i": 46,
  "start": 102.27,
  "end": 104.27,
  "text": "Then he wants forty peanuts."
 },
 {
  "i": 47,
  "start": 105.07,
  "end": 109.39,
  "text": "You start leaving peanuts out for the crows, and the crows start leaving you presents."
 },
 {
  "i": 48,
  "start": 110.1,
  "end": 110.68,
  "text": "A button."
 },
 {
  "i": 49,
  "start": 111.27,
  "end": 112.02,
  "text": "A bottle cap."
 },
 {
  "i": 50,
  "start": 112.74,
  "end": 114.25,
  "text": "A little piece of blue glass."
 },
 {
  "i": 51,
  "start": 114.98,
  "end": 116.31,
  "text": "That really happens."
 },
 {
  "i": 52,
  "start": 117.01,
  "end": 119.85,
  "text": "A girl in Seattle got crow presents for years."
 },
 {
  "i": 53,
  "start": 120.65,
  "end": 123.95,
  "text": "On the school trip to the zoo, the prairie dogs see you coming."
 },
 {
  "i": 54,
  "start": 124.4,
  "end": 124.9,
  "text": "Tall one."
 },
 {
  "i": 55,
  "start": 125.13,
  "end": 125.8,
  "text": "Blue top."
 },
 {
  "i": 56,
  "start": 125.8,
  "end": 126.44,
  "text": "Walks funny."
 },
 {
  "i": 57,
  "start": 127.15,
  "end": 129.28,
  "text": "Theo films you talking to a pigeon."
 },
 {
  "i": 58,
  "start": 129.9,
  "end": 132.05,
  "text": "The video gets two million views."
 },
 {
  "i": 59,
  "start": 132.67,
  "end": 136.44,
  "text": "The comments are full of people asking what their cat really thinks of them."
 },
 {
  "i": 60,
  "start": 137.26,
  "end": 137.74,
  "text": "You know."
 },
 {
  "i": 61,
  "start": 138.39,
  "end": 139.36,
  "text": "You're not telling them."
 },
 {
  "i": 62,
  "start": 140.3,
  "end": 144.77,
  "text": "Then, at four forty-seven in the morning, the birds wake you up."
 },
 {
  "i": 63,
  "start": 145.78,
  "end": 146.08,
  "text": "My tree!"
 },
 {
  "i": 64,
  "start": 146.29,
  "end": 146.58,
  "text": "My tree!"
 },
 {
  "i": 65,
  "start": 146.58,
  "end": 146.76,
  "text": "MY TREE!"
 },
 {
  "i": 66,
  "start": 149.01,
  "end": 150.48,
  "text": "That's not a joke, by the way."
 },
 {
  "i": 67,
  "start": 151.32,
  "end": 156.14,
  "text": "Most birdsong at dawn really means: this is my patch, stay out."
 },
 {
  "i": 68,
  "start": 156.87,
  "end": 158.09,
  "text": "You can't sleep through it."
 },
 {
  "i": 69,
  "start": 158.67,
  "end": 159.89,
  "text": "You can't switch it off."
 },
 {
  "i": 70,
  "start": 160.69,
  "end": 162.78,
  "text": "The mosquito in your room says nothing."
 },
 {
  "i": 71,
  "start": 163.5,
  "end": 167.97,
  "text": "That whine is just its wings, beating hundreds of times a second."
 },
 {
  "i": 72,
  "start": 168.93,
  "end": 171.0,
  "text": "Somehow, that's worse."
 },
 {
  "i": 73,
  "start": 172.01,
  "end": 173.54,
  "text": "Then you make a mistake."
 },
 {
  "i": 74,
  "start": 174.29,
  "end": 177.31,
  "text": "A crow steals your sandwich, and you call him ugly."
 },
 {
  "i": 75,
  "start": 178.06,
  "end": 180.9,
  "text": "The next morning, there are twenty crows on your fence."
 },
 {
  "i": 76,
  "start": 181.55,
  "end": 183.36,
  "text": "The morning after, a hundred."
 },
 {
  "i": 77,
  "start": 184.01,
  "end": 186.46,
  "text": "They dive at your head all the way to school."
 },
 {
  "i": 78,
  "start": 187.22,
  "end": 189.62,
  "text": "Crows remember faces for years."
 },
 {
  "i": 79,
  "start": 190.37,
  "end": 194.59,
  "text": "Scientists in Seattle once caught a few crows while wearing a caveman mask."
 },
 {
  "i": 80,
  "start": 195.44,
  "end": 199.88,
  "text": "Years later, crows that were never caught still screamed at that mask."
 },
 {
  "i": 81,
  "start": 200.59,
  "end": 201.89,
  "text": "The others had taught them."
 },
 {
  "i": 82,
  "start": 202.73,
  "end": 205.43,
  "text": "Now every crow in the city knows your face."
 },
 {
  "i": 83,
  "start": 206.2,
  "end": 207.83,
  "text": "So you keep your hood up."
 },
 {
  "i": 84,
  "start": 207.98,
  "end": 208.91,
  "text": "All the time."
 },
 {
  "i": 85,
  "start": 209.85,
  "end": 213.27,
  "text": "At school, people start calling you Squirrel Kid."
 },
 {
  "i": 86,
  "start": 214.19,
  "end": 217.64,
  "text": "You sit alone at lunch, and a pigeon sits next to you."
 },
 {
  "i": 87,
  "start": 218.66,
  "end": 219.62,
  "text": "It's not the same."
 },
 {
  "i": 88,
  "start": 221.01,
  "end": 222.77,
  "text": "And then there's the pet shop."
 },
 {
  "i": 89,
  "start": 223.75,
  "end": 227.91,
  "text": "You walk in for cat food, and the whole room turns to you at once."
 },
 {
  "i": 90,
  "start": 228.69,
  "end": 229.67,
  "text": "Every puppy."
 },
 {
  "i": 91,
  "start": 230.22,
  "end": 231.15,
  "text": "Every rabbit."
 },
 {
  "i": 92,
  "start": 231.72,
  "end": 233.82,
  "text": "Every bird in every cage."
 },
 {
  "i": 93,
  "start": 234.33,
  "end": 234.91,
  "text": "Pick me."
 },
 {
  "i": 94,
  "start": 235.36,
  "end": 236.11,
  "text": "Pick me."
 },
 {
  "i": 95,
  "start": 236.82,
  "end": 237.31,
  "text": "Take me home."
 },
 {
  "i": 96,
  "start": 238.05,
  "end": 239.31,
  "text": "You can't take them all."
 },
 {
  "i": 97,
  "start": 240.2,
  "end": 241.55,
  "text": "You can't even take one."
 },
 {
  "i": 98,
  "start": 242.65,
  "end": 246.28,
  "text": "You walk out with a bag of cat food, and you don't look back."
 },
 {
  "i": 99,
  "start": 246.74,
  "end": 247.48,
  "text": "Hey."
 },
 {
  "i": 100,
  "start": 247.92,
  "end": 248.69,
  "text": "What's wrong?"
 },
 {
  "i": 101,
  "start": 249.37,
  "end": 250.24,
  "text": "You say nothing."
 },
 {
  "i": 102,
  "start": 251.15,
  "end": 252.31,
  "text": "Biscuit doesn't either."
 },
 {
  "i": 103,
  "start": 253.46,
  "end": 256.54,
  "text": "But that night, he sleeps across your doorway."
 },
 {
  "i": 104,
  "start": 257.96,
  "end": 258.61,
  "text": "So..."
 },
 {
  "i": 105,
  "start": 259.21,
  "end": 260.95,
  "text": "could animals really talk?"
 },
 {
  "i": 106,
  "start": 261.74,
  "end": 263.58,
  "text": "In a way, they already do."
 },
 {
  "i": 107,
  "start": 264.25,
  "end": 265.54,
  "text": "Remember the prairie dogs?"
 },
 {
  "i": 108,
  "start": 266.22,
  "end": 267.07,
  "text": "That's real."
 },
 {
  "i": 109,
  "start": 267.81,
  "end": 271.68,
  "text": "A biologist in Arizona spent years recording their alarm calls."
 },
 {
  "i": 110,
  "start": 272.33,
  "end": 274.0,
  "text": "They don't just shout \"danger\"."
 },
 {
  "i": 111,
  "start": 274.6,
  "end": 280.29,
  "text": "They describe what's coming: a person, how tall, even the colour of their shirt."
 },
 {
  "i": 112,
  "start": 280.29,
  "end": 285.58,
  "text": "Vervet monkeys have different alarms for a leopard, an eagle and a snake."
 },
 {
  "i": 113,
  "start": 286.31,
  "end": 288.61,
  "text": "Hear \"eagle\", and they look up."
 },
 {
  "i": 114,
  "start": 289.33,
  "end": 291.7,
  "text": "Hear \"snake\", and they look down."
 },
 {
  "i": 115,
  "start": 292.63,
  "end": 296.91,
  "text": "Honeybees dance to tell each other which way the flowers are, and how far."
 },
 {
  "i": 116,
  "start": 297.75,
  "end": 300.11,
  "text": "That dance won a Nobel Prize in nineteen seventy-three."
 },
 {
  "i": 117,
  "start": 301.75,
  "end": 307.2,
  "text": "And in twenty twenty-four, scientists in Kenya found that wild elephants have names too."
 },
 {
  "i": 118,
  "start": 307.93,
  "end": 311.29,
  "text": "Play an elephant a call meant for her, and she calls back."
 },
 {
  "i": 119,
  "start": 312.11,
  "end": 313.15,
  "text": "Meant for someone else?"
 },
 {
  "i": 120,
  "start": 313.86,
  "end": 315.03,
  "text": "She mostly ignores it."
 },
 {
  "i": 121,
  "start": 315.86,
  "end": 317.64,
  "text": "And here's one the internet gets wrong:"
 },
 {
  "i": 122,
  "start": 318.47,
  "end": 321.09,
  "text": "one dog year isn't seven human years."
 },
 {
  "i": 123,
  "start": 321.91,
  "end": 328.78,
  "text": "A twenty twenty study of Labradors' DNA worked out that a fourteen-year-old dog is about seventy-three."
 },
 {
  "i": 124,
  "start": 328.78,
  "end": 331.84,
  "text": "Biscuit is seventy-three."
 },
 {
  "i": 125,
  "start": 331.84,
  "end": 338.55,
  "text": "Right now, a team called Project CETI is using AI to decode the clicks of sperm whales."
 },
 {
  "i": 126,
  "start": 339.42,
  "end": 342.04,
  "text": "They've already found patterns in them, like an alphabet."
 },
 {
  "i": 127,
  "start": 342.85,
  "end": 344.95,
  "text": "None of these animals talk the way we do."
 },
 {
  "i": 128,
  "start": 345.6,
  "end": 347.82,
  "text": "But every one of them is saying something."
 },
 {
  "i": 129,
  "start": 348.69,
  "end": 350.44,
  "text": "We just never learned how to listen."
 },
 {
  "i": 130,
  "start": 351.57,
  "end": 352.87,
  "text": "Remember the whales."
 },
 {
  "i": 131,
  "start": 353.61,
  "end": 355.07,
  "text": "You're going to hear them again."
 },
 {
  "i": 132,
  "start": 356.31,
  "end": 358.38,
  "text": "A week later, an email arrives."
 },
 {
  "i": 133,
  "start": 359.18,
  "end": 361.73,
  "text": "Project CETI has seen your video."
 },
 {
  "i": 134,
  "start": 362.36,
  "end": 363.57,
  "text": "They send you a recording."
 },
 {
  "i": 135,
  "start": 364.22,
  "end": 365.39,
  "text": "You put on the headphones."
 },
 {
  "i": 136,
  "start": 366.07,
  "end": 366.7,
  "text": "Clicks."
 },
 {
  "i": 137,
  "start": 367.36,
  "end": 369.28,
  "text": "Long, slow clicks."
 },
 {
  "i": 138,
  "start": 370.08,
  "end": 372.58,
  "text": "And under the clicks, words."
 },
 {
  "i": 139,
  "start": 373.47,
  "end": 375.25,
  "text": "A mother whale calling her calf."
 },
 {
  "i": 140,
  "start": 375.92,
  "end": 378.6,
  "text": "The same name, over and over."
 },
 {
  "i": 141,
  "start": 379.39,
  "end": 380.25,
  "text": "You write it down."
 },
 {
  "i": 142,
  "start": 380.97,
  "end": 381.87,
  "text": "They don't believe you."
 },
 {
  "i": 143,
  "start": 382.65,
  "end": 383.92,
  "text": "Then they check their tapes."
 },
 {
  "i": 144,
  "start": 384.68,
  "end": 387.85,
  "text": "Every time she calls that name, the calf answers."
 },
 {
  "i": 145,
  "start": 388.66,
  "end": 392.01,
  "text": "The news calls you the kid who talks to whales."
 },
 {
  "i": 146,
  "start": 393.19,
  "end": 396.31,
  "text": "But that night, Biscuit doesn't come up the stairs."
 },
 {
  "i": 147,
  "start": 397.12,
  "end": 399.66,
  "text": "You find him at the bottom, looking up at you."
 },
 {
  "i": 148,
  "start": 400.18,
  "end": 401.54,
  "text": "It's my back legs."
 },
 {
  "i": 149,
  "start": 401.99,
  "end": 403.18,
  "text": "They do this now."
 },
 {
  "i": 150,
  "start": 403.88,
  "end": 404.76,
  "text": "You carry him up."
 },
 {
  "i": 151,
  "start": 405.56,
  "end": 406.98,
  "text": "He's lighter than he used to be."
 },
 {
  "i": 152,
  "start": 407.45,
  "end": 408.76,
  "text": "Don't tell your mom."
 },
 {
  "i": 153,
  "start": 409.0,
  "end": 409.91,
  "text": "She'll worry."
 },
 {
  "i": 154,
  "start": 410.55,
  "end": 412.28,
  "text": "He's been hurting since the winter."
 },
 {
  "i": 155,
  "start": 412.93,
  "end": 414.37,
  "text": "He just couldn't tell anyone."
 },
 {
  "i": 156,
  "start": 415.25,
  "end": 416.01,
  "text": "Until now."
 },
 {
  "i": 157,
  "start": 416.99,
  "end": 417.79,
  "text": "You tell Mom."
 },
 {
  "i": 158,
  "start": 418.59,
  "end": 419.58,
  "text": "The vet is kind."
 },
 {
  "i": 159,
  "start": 420.33,
  "end": 423.01,
  "text": "His hips are worn out, and his heart is tired."
 },
 {
  "i": 160,
  "start": 423.94,
  "end": 424.52,
  "text": "Weeks."
 },
 {
  "i": 161,
  "start": 425.28,
  "end": 426.08,
  "text": "Maybe less."
 },
 {
  "i": 162,
  "start": 427.13,
  "end": 429.41,
  "text": "So you spend every one of them together."
 },
 {
  "i": 163,
  "start": 430.33,
  "end": 433.4,
  "text": "He tells you he's hated the vacuum cleaner since day one."
 },
 {
  "i": 164,
  "start": 434.08,
  "end": 436.58,
  "text": "That he can hear Mom's car two streets away."
 },
 {
  "i": 165,
  "start": 437.22,
  "end": 439.37,
  "text": "That's why he's always at the door first."
 },
 {
  "i": 166,
  "start": 439.81,
  "end": 443.09,
  "text": "The day you were born, everybody left in a hurry."
 },
 {
  "i": 167,
  "start": 443.57,
  "end": 445.8,
  "text": "I waited by the door for two days."
 },
 {
  "i": 168,
  "start": 446.31,
  "end": 448.0,
  "text": "Then they came back with you."
 },
 {
  "i": 169,
  "start": 448.38,
  "end": 451.13,
  "text": "You were very small and very loud."
 },
 {
  "i": 170,
  "start": 451.48,
  "end": 452.85,
  "text": "I liked you right away."
 },
 {
  "i": 171,
  "start": 453.54,
  "end": 458.31,
  "text": "On the last night, he lies in his sunny spot, even though it's dark."
 },
 {
  "i": 172,
  "start": 458.76,
  "end": 461.16,
  "text": "You talked to me every day of your life."
 },
 {
  "i": 173,
  "start": 461.67,
  "end": 462.92,
  "text": "I always understood."
 },
 {
  "i": 174,
  "start": 463.5,
  "end": 465.77,
  "text": "This year, you understood me back."
 },
 {
  "i": 175,
  "start": 466.2,
  "end": 466.99,
  "text": "Best year."
 },
 {
  "i": 176,
  "start": 467.54,
  "end": 469.03,
  "text": "Don't be sad for too long."
 },
 {
  "i": 177,
  "start": 469.31,
  "end": 469.8,
  "text": "Okay?"
 },
 {
  "i": 178,
  "start": 470.46,
  "end": 471.0,
  "text": "You say"
 },
 {
  "i": 179,
  "start": 471.8,
  "end": 472.32,
  "text": "okay."
 },
 {
  "i": 180,
  "start": 472.72,
  "end": 475.1,
  "text": "It's the first time you ever lied to him."
 },
 {
  "i": 181,
  "start": 476.06,
  "end": 478.19,
  "text": "He falls asleep with his head on your foot."
 },
 {
  "i": 182,
  "start": 478.98,
  "end": 480.16,
  "text": "And he doesn't wake up."
 },
 {
  "i": 183,
  "start": 481.58,
  "end": 483.79,
  "text": "For weeks, you can't go to the park."
 },
 {
  "i": 184,
  "start": 484.68,
  "end": 486.47,
  "text": "Every dog there says hello."
 },
 {
  "i": 185,
  "start": 487.26,
  "end": 488.57,
  "text": "None of them sound like him."
 },
 {
  "i": 186,
  "start": 489.34,
  "end": 491.16,
  "text": "And there's still no off switch."
 },
 {
  "i": 187,
  "start": 492.71,
  "end": 498.92,
  "text": "Then one morning, at four forty-seven, you wake up, and something's wrong."
 },
 {
  "i": 188,
  "start": 500.03,
  "end": 500.78,
  "text": "It's quiet."
 },
 {
  "i": 189,
  "start": 501.54,
  "end": 502.36,
  "text": "No birds."
 },
 {
  "i": 190,
  "start": 502.95,
  "end": 504.38,
  "text": "No \"my tree\"."
 },
 {
  "i": 191,
  "start": 505.15,
  "end": 506.87,
  "text": "Not one crow on the fence."
 },
 {
  "i": 192,
  "start": 507.96,
  "end": 512.78,
  "text": "Pickles is sitting at the window, ears flat, staring toward the sea."
 },
 {
  "i": 193,
  "start": 513.88,
  "end": 514.68,
  "text": "Then you hear it."
 },
 {
  "i": 194,
  "start": 515.51,
  "end": 516.55,
  "text": "Not from the garden."
 },
 {
  "i": 195,
  "start": 517.27,
  "end": 519.51,
  "text": "From very, very far away."
 },
 {
  "i": 196,
  "start": 520.33,
  "end": 522.62,
  "text": "Deeper than any voice you've ever heard."
 },
 {
  "i": 197,
  "start": 523.3,
  "end": 524.43,
  "text": "Thousands of them."
 },
 {
  "i": 198,
  "start": 525.06,
  "end": 527.09,
  "text": "Saying the same three words."
 },
 {
  "i": 199,
  "start": 527.59,
  "end": 528.49,
  "text": "We hear you."
 },
 {
  "i": 200,
  "start": 532.4,
  "end": 533.89,
  "text": "Pickles doesn't turn around."
 },
 {
  "i": 201,
  "start": 534.37,
  "end": 536.25,
  "text": "They've been asking for you all night."
 },
 {
  "i": 202,
  "start": 536.98,
  "end": 542.81,
  "text": "So, if you could talk to animals, who would you talk to first, and what would you ask?"
 },
 {
  "i": 203,
  "start": 543.51,
  "end": 544.66,
  "text": "Tell me in the comments."
 },
 {
  "i": 204,
  "start": 545.21,
  "end": 548.62,
  "text": "And subscribe, because the whales aren't done talking."
 }
]