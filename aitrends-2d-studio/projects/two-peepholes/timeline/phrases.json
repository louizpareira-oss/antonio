[
  {
    "start": 0.05,
    "end": 0.93,
    "text": "Your front door",
    "highlight": []
  },
  {
    "start": 0.93,
    "end": 2.61,
    "text": "has one peephole.",
    "highlight": [
      "one"
    ],
    "highlightColor": "#f4d34e"
  },
  {
    "start": 2.61,
    "end": 3.33,
    "text": "If you come home",
    "highlight": []
  },
  {
    "start": 3.33,
    "end": 4.77,
    "text": "and there are two…",
    "highlight": [
      "two"
    ],
    "highlightColor": "#f4d34e"
  },
  {
    "start": 4.77,
    "end": 6.22,
    "text": "don't use the NEW one.",
    "highlight": [
      "NEW"
    ],
    "highlightColor": "#ef334e"
  },
  {
    "start": 6.45,
    "end": 7.05,
    "text": "The old one",
    "highlight": []
  },
  {
    "start": 7.05,
    "end": 8.53,
    "text": "lets the hallway light in.",
    "highlight": [
      "light"
    ],
    "highlightColor": "#f4d34e"
  },
  {
    "start": 8.53,
    "end": 10.3,
    "text": "The new one stays dark.",
    "highlight": [
      "dark"
    ],
    "highlightColor": "#ef334e"
  },
  {
    "start": 10.61,
    "end": 11.69,
    "text": "Through the old one,",
    "highlight": []
  },
  {
    "start": 11.69,
    "end": 13.18,
    "text": "the hallway is empty.",
    "highlight": [
      "empty"
    ],
    "highlightColor": "#50d78c"
  },
  {
    "start": 13.33,
    "end": 14.73,
    "text": "So why is the new one",
    "highlight": []
  },
  {
    "start": 14.73,
    "end": 15.74,
    "text": "still dark?",
    "highlight": [
      "dark"
    ],
    "highlightColor": "#ef334e"
  },
  {
    "start": 16.997,
    "end": 17.89,
    "text": "It isn't there for you",
    "highlight": []
  },
  {
    "start": 17.89,
    "end": 19.09,
    "text": "to look out.",
    "highlight": []
  },
  {
    "start": 19.09,
    "end": 20.13,
    "text": "It's there for something",
    "highlight": []
  },
  {
    "start": 20.13,
    "end": 21.34,
    "text": "to look IN.",
    "highlight": [
      "IN"
    ],
    "highlightColor": "#ef334e"
  },
  {
    "start": 25.05,
    "end": 26.1,
    "text": "Rule two.",
    "highlight": []
  },
  {
    "start": 26.33,
    "end": 27.77,
    "text": "If both are dark,",
    "highlight": [
      "dark"
    ],
    "highlightColor": "#ef334e"
  },
  {
    "start": 27.77,
    "end": 28.57,
    "text": "sit with your back",
    "highlight": []
  },
  {
    "start": 28.57,
    "end": 29.85,
    "text": "against the door.",
    "highlight": [
      "door"
    ],
    "highlightColor": "#f4d34e"
  },
  {
    "start": 29.85,
    "end": 31.46,
    "text": "You can't see out anymore.",
    "highlight": []
  },
  {
    "start": 31.61,
    "end": 33.13,
    "text": "But it can't see everything,",
    "highlight": [
      "everything"
    ],
    "highlightColor": "#f4d34e"
  },
  {
    "start": 33.13,
    "end": 33.78,
    "text": "either.",
    "highlight": []
  },
  {
    "start": 33.85,
    "end": 35.13,
    "text": "A peephole only looks",
    "highlight": []
  },
  {
    "start": 35.13,
    "end": 36.17,
    "text": "one way.",
    "highlight": [
      "one"
    ],
    "highlightColor": "#f4d34e"
  },
  {
    "start": 36.17,
    "end": 37.94,
    "text": "In, and a little down.",
    "highlight": [
      "down"
    ],
    "highlightColor": "#f4d34e"
  },
  {
    "start": 38.09,
    "end": 39.05,
    "text": "So there's one place",
    "highlight": []
  },
  {
    "start": 39.05,
    "end": 40.33,
    "text": "it can't reach:",
    "highlight": []
  },
  {
    "start": 40.33,
    "end": 41.7,
    "text": "right underneath it.",
    "highlight": [
      "underneath"
    ],
    "highlightColor": "#50d78c"
  },
  {
    "start": 41.93,
    "end": 42.9,
    "text": "Sit there.",
    "highlight": []
  },
  {
    "start": 42.97,
    "end": 44.5,
    "text": "Back flat to the door.",
    "highlight": []
  },
  {
    "start": 44.65,
    "end": 46.26,
    "text": "Don't get up until morning.",
    "highlight": [
      "morning"
    ],
    "highlightColor": "#f4d34e"
  },
  {
    "start": 46.33,
    "end": 47.54,
    "text": "It will look for you.",
    "highlight": [
      "look"
    ],
    "highlightColor": "#ef334e"
  },
  {
    "start": 47.61,
    "end": 48.65,
    "text": "At the table.",
    "highlight": [
      "table"
    ],
    "highlightColor": "#f4d34e"
  },
  {
    "start": 48.65,
    "end": 49.77,
    "text": "At the picture.",
    "highlight": [
      "picture"
    ],
    "highlightColor": "#f4d34e"
  },
  {
    "start": 49.77,
    "end": 50.41,
    "text": "At the spot",
    "highlight": [
      "spot"
    ],
    "highlightColor": "#f4d34e"
  },
  {
    "start": 50.41,
    "end": 51.86,
    "text": "where the light used to be.",
    "highlight": []
  },
  {
    "start": 52.17,
    "end": 53.22,
    "text": "Let it look.",
    "highlight": []
  },
  {
    "start": 54.01,
    "end": 55.14,
    "text": "Rule three.",
    "highlight": []
  },
  {
    "start": 55.29,
    "end": 56.58,
    "text": "Don't cover them.",
    "highlight": [
      "cover"
    ],
    "highlightColor": "#ef334e"
  },
  {
    "start": 56.73,
    "end": 57.61,
    "text": "Tape feels like",
    "highlight": []
  },
  {
    "start": 57.61,
    "end": 58.9,
    "text": "the right idea.",
    "highlight": []
  },
  {
    "start": 59.359,
    "end": 60.41,
    "text": "It isn't.",
    "highlight": [
      "isn't"
    ],
    "highlightColor": "#ef334e"
  },
  {
    "start": 60.41,
    "end": 61.17,
    "text": "Cover both,",
    "highlight": []
  },
  {
    "start": 61.17,
    "end": 62.73,
    "text": "and it doesn't stop looking.",
    "highlight": []
  },
  {
    "start": 62.73,
    "end": 63.77,
    "text": "It just finds somewhere",
    "highlight": []
  },
  {
    "start": 63.77,
    "end": 65.14,
    "text": "closer to look from.",
    "highlight": [
      "closer"
    ],
    "highlightColor": "#ef334e"
  },
  {
    "start": 65.29,
    "end": 66.33,
    "text": "The picture on your wall",
    "highlight": []
  },
  {
    "start": 66.33,
    "end": 67.89,
    "text": "has hung there for years.",
    "highlight": []
  },
  {
    "start": 67.89,
    "end": 68.57,
    "text": "It has never",
    "highlight": []
  },
  {
    "start": 68.57,
    "end": 69.7,
    "text": "had a hole in it.",
    "highlight": [
      "hole"
    ],
    "highlightColor": "#f4d34e"
  },
  {
    "start": 70.147,
    "end": 71.37,
    "text": "It does now.",
    "highlight": [
      "now"
    ],
    "highlightColor": "#ef334e"
  },
  {
    "start": 71.37,
    "end": 72.25,
    "text": "And from there,",
    "highlight": []
  },
  {
    "start": 72.25,
    "end": 73.37,
    "text": "it can see exactly",
    "highlight": [
      "exactly"
    ],
    "highlightColor": "#ef334e"
  },
  {
    "start": 73.37,
    "end": 74.65,
    "text": "where you're sitting.",
    "highlight": []
  },
  {
    "start": 74.65,
    "end": 75.89,
    "text": "Two holes you know about",
    "highlight": []
  },
  {
    "start": 75.89,
    "end": 76.65,
    "text": "are safer than",
    "highlight": [
      "safer"
    ],
    "highlightColor": "#50d78c"
  },
  {
    "start": 76.65,
    "end": 77.647,
    "text": "one you don't.",
    "highlight": []
  },
  {
    "start": 78.33,
    "end": 79.38,
    "text": "Rule four.",
    "highlight": []
  },
  {
    "start": 79.61,
    "end": 81.18,
    "text": "Wait for the light.",
    "highlight": [
      "light"
    ],
    "highlightColor": "#f4d34e"
  },
  {
    "start": 81.21,
    "end": 82.61,
    "text": "Some time before morning,",
    "highlight": []
  },
  {
    "start": 82.61,
    "end": 83.37,
    "text": "the hallway light",
    "highlight": [
      "light"
    ],
    "highlightColor": "#f4d34e"
  },
  {
    "start": 83.37,
    "end": 84.01,
    "text": "will come back",
    "highlight": []
  },
  {
    "start": 84.01,
    "end": 85.17,
    "text": "through the old one.",
    "highlight": [
      "old"
    ],
    "highlightColor": "#f4d34e"
  },
  {
    "start": 85.17,
    "end": 86.61,
    "text": "It will land on your floor,",
    "highlight": [
      "floor"
    ],
    "highlightColor": "#f4d34e"
  },
  {
    "start": 86.61,
    "end": 88.05,
    "text": "right where it always does.",
    "highlight": []
  },
  {
    "start": 88.05,
    "end": 88.81,
    "text": "And the new one",
    "highlight": []
  },
  {
    "start": 88.81,
    "end": 90.09,
    "text": "will be gone.",
    "highlight": [
      "gone"
    ],
    "highlightColor": "#50d78c"
  },
  {
    "start": 90.09,
    "end": 90.89,
    "text": "That means it has",
    "highlight": []
  },
  {
    "start": 90.89,
    "end": 92.18,
    "text": "let go of the door.",
    "highlight": []
  },
  {
    "start": 92.33,
    "end": 93.53,
    "text": "Before you get up,",
    "highlight": []
  },
  {
    "start": 93.53,
    "end": 94.65,
    "text": "look at the light.",
    "highlight": [
      "light"
    ],
    "highlightColor": "#f4d34e"
  },
  {
    "start": 94.65,
    "end": 96.01,
    "text": "If it's only light,",
    "highlight": [
      "only"
    ],
    "highlightColor": "#50d78c"
  },
  {
    "start": 96.01,
    "end": 97.58,
    "text": "you can go to bed.",
    "highlight": []
  },
  {
    "start": 97.827,
    "end": 98.33,
    "text": "If something",
    "highlight": []
  },
  {
    "start": 98.33,
    "end": 99.78,
    "text": "is standing in it…",
    "highlight": [
      "standing"
    ],
    "highlightColor": "#ef334e"
  },
  {
    "start": 100.863,
    "end": 102.66,
    "text": "it didn't go back outside.",
    "highlight": []
  },
  {
    "start": 102.97,
    "end": 104.5,
    "text": "It came IN.",
    "highlight": [
      "IN"
    ],
    "highlightColor": "#ef334e"
  }
]