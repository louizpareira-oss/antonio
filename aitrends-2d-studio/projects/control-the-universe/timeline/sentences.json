[
 {
  "i": 0,
  "start": 0.0,
  "end": 2.61,
  "text": "Can one person really control the universe?"
 },
 {
  "i": 1,
  "start": 3.34,
  "end": 4.25,
  "text": "Not in a movie."
 },
 {
  "i": 2,
  "start": 4.7,
  "end": 5.82,
  "text": "With real physics."
 },
 {
  "i": 3,
  "start": 6.35,
  "end": 7.09,
  "text": "Let's find out."
 },
 {
  "i": 4,
  "start": 7.71,
  "end": 11.92,
  "text": "This morning, at seven fifty-nine, your coffee stopped falling."
 },
 {
  "i": 5,
  "start": 12.57,
  "end": 13.66,
  "text": "It's just hanging there."
 },
 {
  "i": 6,
  "start": 14.21,
  "end": 15.5,
  "text": "One inch from the floor."
 },
 {
  "i": 7,
  "start": 16.11,
  "end": 19.74,
  "text": "And there's a gold stone in your hand, humming like a phone on silent."
 },
 {
  "i": 8,
  "start": 20.61,
  "end": 23.68,
  "text": "Last night, six lights fell into Grandma's backyard."
 },
 {
  "i": 9,
  "start": 24.17,
  "end": 25.21,
  "text": "Six stones."
 },
 {
  "i": 10,
  "start": 25.75,
  "end": 26.29,
  "text": "Time."
 },
 {
  "i": 11,
  "start": 26.54,
  "end": 27.23,
  "text": "Space."
 },
 {
  "i": 12,
  "start": 27.66,
  "end": 28.26,
  "text": "Energy."
 },
 {
  "i": 13,
  "start": 28.67,
  "end": 29.22,
  "text": "Mind."
 },
 {
  "i": 14,
  "start": 29.63,
  "end": 30.2,
  "text": "Matter."
 },
 {
  "i": 15,
  "start": 30.69,
  "end": 31.36,
  "text": "And life."
 },
 {
  "i": 16,
  "start": 32.18,
  "end": 32.88,
  "text": "Here's the rule."
 },
 {
  "i": 17,
  "start": 33.49,
  "end": 35.17,
  "text": "Every stone gives you something."
 },
 {
  "i": 18,
  "start": 35.64,
  "end": 37.62,
  "text": "And every stone takes something back."
 },
 {
  "i": 19,
  "start": 38.23,
  "end": 38.86,
  "text": "Remember that."
 },
 {
  "i": 20,
  "start": 39.53,
  "end": 42.35,
  "text": "Grandma Rosa was an astronomer for forty years."
 },
 {
  "i": 21,
  "start": 42.83,
  "end": 44.19,
  "text": "That one's Vega."
 },
 {
  "i": 22,
  "start": 44.55,
  "end": 45.92,
  "text": "That one's a satellite."
 },
 {
  "i": 23,
  "start": 46.26,
  "end": 47.19,
  "text": "That one's..."
 },
 {
  "i": 24,
  "start": 47.35,
  "end": 48.05,
  "text": "a plane."
 },
 {
  "i": 25,
  "start": 48.59,
  "end": 49.23,
  "text": "Never mind."
 },
 {
  "i": 26,
  "start": 49.94,
  "end": 51.68,
  "text": "Lately, she forgets things."
 },
 {
  "i": 27,
  "start": 52.21,
  "end": 52.98,
  "text": "Her glasses."
 },
 {
  "i": 28,
  "start": 53.5,
  "end": 54.49,
  "text": "They're on her head."
 },
 {
  "i": 29,
  "start": 55.1,
  "end": 56.64,
  "text": "Sometimes, your name."
 },
 {
  "i": 30,
  "start": 57.34,
  "end": 58.98,
  "text": "But she never forgets a star."
 },
 {
  "i": 31,
  "start": 59.64,
  "end": 60.25,
  "text": "Day one."
 },
 {
  "i": 32,
  "start": 60.71,
  "end": 61.25,
  "text": "You're late."
 },
 {
  "i": 33,
  "start": 61.69,
  "end": 65.26,
  "text": "You freeze time, walk past the frozen bus, and sit down early."
 },
 {
  "i": 34,
  "start": 65.85,
  "end": 66.52,
  "text": "Math test."
 },
 {
  "i": 35,
  "start": 66.95,
  "end": 67.69,
  "text": "Wrong answer."
 },
 {
  "i": 36,
  "start": 68.15,
  "end": 69.65,
  "text": "You rewind ten seconds."
 },
 {
  "i": 37,
  "start": 70.11,
  "end": 70.47,
  "text": "Blink."
 },
 {
  "i": 38,
  "start": 70.98,
  "end": 72.21,
  "text": "You're first in the lunch line."
 },
 {
  "i": 39,
  "start": 72.62,
  "end": 73.0,
  "text": "Blink."
 },
 {
  "i": 40,
  "start": 73.0,
  "end": 74.65,
  "text": "Ramen in Tokyo."
 },
 {
  "i": 41,
  "start": 75.05,
  "end": 75.44,
  "text": "Blink."
 },
 {
  "i": 42,
  "start": 75.93,
  "end": 76.93,
  "text": "Back before the bell."
 },
 {
  "i": 43,
  "start": 77.56,
  "end": 80.13,
  "text": "Every dead phone in class charges in your hand."
 },
 {
  "i": 44,
  "start": 80.73,
  "end": 82.21,
  "text": "Broccoli turns into fries."
 },
 {
  "i": 45,
  "start": 82.64,
  "end": 85.79,
  "text": "And every stone you touch snaps onto your hoodie."
 },
 {
  "i": 46,
  "start": 85.79,
  "end": 87.57,
  "text": "By Friday, you have gloves."
 },
 {
  "i": 47,
  "start": 87.9,
  "end": 88.35,
  "text": "Boots."
 },
 {
  "i": 48,
  "start": 88.56,
  "end": 89.21,
  "text": "And a cape."
 },
 {
  "i": 49,
  "start": 89.88,
  "end": 91.17,
  "text": "You didn't ask for the cape."
 },
 {
  "i": 50,
  "start": 91.82,
  "end": 93.86,
  "text": "But every stone takes something back."
 },
 {
  "i": 51,
  "start": 94.52,
  "end": 96.66,
  "text": "When you freeze time, you keep living."
 },
 {
  "i": 52,
  "start": 97.32,
  "end": 100.04,
  "text": "By Sunday, you're nine days older than your birthday."
 },
 {
  "i": 53,
  "start": 100.63,
  "end": 104.75,
  "text": "Every teleport leaves a hole in the air, and the air slams back in."
 },
 {
  "i": 54,
  "start": 105.22,
  "end": 105.6,
  "text": "Boom."
 },
 {
  "i": 55,
  "start": 106.12,
  "end": 107.33,
  "text": "The school windows crack."
 },
 {
  "i": 56,
  "start": 107.75,
  "end": 109.63,
  "text": "The mind stone has no off switch."
 },
 {
  "i": 57,
  "start": 110.17,
  "end": 113.35,
  "text": "At the football game, you hear forty thousand thoughts at once."
 },
 {
  "i": 58,
  "start": 113.86,
  "end": 115.63,
  "text": "One of them is your best friend's."
 },
 {
  "i": 59,
  "start": 116.11,
  "end": 117.53,
  "text": "I liked him better before."
 },
 {
  "i": 60,
  "start": 118.25,
  "end": 120.82,
  "text": "And six stones together bend time around you."
 },
 {
  "i": 61,
  "start": 121.3,
  "end": 123.14,
  "text": "Just a few billionths of a second."
 },
 {
  "i": 62,
  "start": 123.64,
  "end": 124.31,
  "text": "That's enough."
 },
 {
  "i": 63,
  "start": 125.0,
  "end": 127.11,
  "text": "Every GPS near you is wrong."
 },
 {
  "i": 64,
  "start": 127.67,
  "end": 129.52,
  "text": "Map apps send cars into the river."
 },
 {
  "i": 65,
  "start": 130.04,
  "end": 131.93,
  "text": "NASA calls it the anomaly."
 },
 {
  "i": 66,
  "start": 132.77,
  "end": 133.4,
  "text": "It's you."
 },
 {
  "i": 67,
  "start": 134.1,
  "end": 134.63,
  "text": "So."
 },
 {
  "i": 68,
  "start": 135.21,
  "end": 136.34,
  "text": "Is any of this real?"
 },
 {
  "i": 69,
  "start": 136.94,
  "end": 138.5,
  "text": "Time really does bend."
 },
 {
  "i": 70,
  "start": 139.06,
  "end": 143.87,
  "text": "Clocks on GPS satellites run thirty-eight millionths of a second faster every day."
 },
 {
  "i": 71,
  "start": 144.39,
  "end": 147.82,
  "text": "Without a fix, your map would be ten kilometres off by tonight."
 },
 {
  "i": 72,
  "start": 147.82,
  "end": 149.46,
  "text": "Teleporting people?"
 },
 {
  "i": 73,
  "start": 149.97,
  "end": 150.3,
  "text": "No."
 },
 {
  "i": 74,
  "start": 150.78,
  "end": 157.53,
  "text": "But in twenty seventeen, scientists teleported the state of a particle of light to a satellite more than a thousand kilometres up."
 },
 {
  "i": 75,
  "start": 158.22,
  "end": 158.73,
  "text": "Energy?"
 },
 {
  "i": 76,
  "start": 159.27,
  "end": 163.88,
  "text": "Turn one paperclip completely into energy, and you'd beat the bomb that hit Hiroshima."
 },
 {
  "i": 77,
  "start": 164.5,
  "end": 167.5,
  "text": "And there's a jellyfish that can turn itself back into a baby."
 },
 {
  "i": 78,
  "start": 168.08,
  "end": 170.67,
  "text": "Scientists call it the immortal jellyfish."
 },
 {
  "i": 79,
  "start": 171.28,
  "end": 172.66,
  "text": "Every power is real."
 },
 {
  "i": 80,
  "start": 173.02,
  "end": 174.66,
  "text": "Just never all in one hand."
 },
 {
  "i": 81,
  "start": 175.53,
  "end": 177.63,
  "text": "One night, Grandma doesn't know you."
 },
 {
  "i": 82,
  "start": 178.25,
  "end": 180.66,
  "text": "She sees the cape, and she steps back."
 },
 {
  "i": 83,
  "start": 181.13,
  "end": 181.94,
  "text": "Who are you?"
 },
 {
  "i": 84,
  "start": 181.94,
  "end": 183.53,
  "text": "Where's my grandson?"
 },
 {
  "i": 85,
  "start": 184.24,
  "end": 186.27,
  "text": "The life stone fixes what's broken."
 },
 {
  "i": 86,
  "start": 186.82,
  "end": 188.21,
  "text": "And it takes something back."
 },
 {
  "i": 87,
  "start": 188.83,
  "end": 190.65,
  "text": "A memory, for a memory."
 },
 {
  "i": 88,
  "start": 191.32,
  "end": 192.68,
  "text": "You press it into her hand."
 },
 {
  "i": 89,
  "start": 193.25,
  "end": 193.97,
  "text": "She blinks."
 },
 {
  "i": 90,
  "start": 194.52,
  "end": 195.35,
  "text": "She smiles."
 },
 {
  "i": 91,
  "start": 195.92,
  "end": 196.92,
  "text": "There you are."
 },
 {
  "i": 92,
  "start": 197.32,
  "end": 198.43,
  "text": "You got tall."
 },
 {
  "i": 93,
  "start": 199.09,
  "end": 201.84,
  "text": "You get one perfect day at the old observatory."
 },
 {
  "i": 94,
  "start": 202.41,
  "end": 206.03,
  "text": "And you realise you can't remember the first night she showed you the stars."
 },
 {
  "i": 95,
  "start": 206.67,
  "end": 207.86,
  "text": "That's what the stone took."
 },
 {
  "i": 96,
  "start": 208.31,
  "end": 209.38,
  "text": "You were six."
 },
 {
  "i": 97,
  "start": 209.83,
  "end": 212.27,
  "text": "You asked me if the stars could see us back."
 },
 {
  "i": 98,
  "start": 213.0,
  "end": 213.77,
  "text": "I said yes."
 },
 {
  "i": 99,
  "start": 214.42,
  "end": 215.89,
  "text": "Then she goes quiet."
 },
 {
  "i": 100,
  "start": 216.43,
  "end": 218.15,
  "text": "I've seen these stones before."
 },
 {
  "i": 101,
  "start": 218.63,
  "end": 220.32,
  "text": "Nineteen sixty-nine."
 },
 {
  "i": 102,
  "start": 220.32,
  "end": 221.25,
  "text": "Six lights."
 },
 {
  "i": 103,
  "start": 221.57,
  "end": 222.54,
  "text": "Same backyard."
 },
 {
  "i": 104,
  "start": 223.2,
  "end": 226.31,
  "text": "That night, NASA picks up six new lights."
 },
 {
  "i": 105,
  "start": 226.92,
  "end": 227.79,
  "text": "They're not falling."
 },
 {
  "i": 106,
  "start": 228.29,
  "end": 229.33,
  "text": "They're slowing down."
 },
 {
  "i": 107,
  "start": 229.98,
  "end": 231.6,
  "text": "They're not coming back for the stones."
 },
 {
  "i": 108,
  "start": 232.17,
  "end": 234.32,
  "text": "They're coming back for whoever could hold them."
 },
 {
  "i": 109,
  "start": 235.1,
  "end": 236.73,
  "text": "Your coffee stops falling."
 },
 {
  "i": 110,
  "start": 237.96,
  "end": 241.19,
  "text": "If you could keep only one stone, which one would you keep?"
 },
 {
  "i": 111,
  "start": 241.76,
  "end": 242.76,
  "text": "Tell me in the comments."
 },
 {
  "i": 112,
  "start": 243.13,
  "end": 245.46,
  "text": "And subscribe, because they're almost here."
 }
]